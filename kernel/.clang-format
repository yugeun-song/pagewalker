BasedOnStyle: LLVM
IndentWidth: 8
UseTab: Always
TabWidth: 8
ContinuationIndentWidth: 8
ColumnLimit: 0
BreakBeforeBraces: Custom
BraceWrapping:
    AfterFunction: true
InsertBraces: true
AllowShortFunctionsOnASingleLine:
    Empty: false
    Inline: false
    Other: false
AllowShortEnumsOnASingleLine: false
Cpp11BracedListStyle: Block
AlignTrailingComments:
    Kind: Never
AlignEscapedNewlines: Left
IndentPPDirectives: AfterHash
PPIndentWidth: 1
IncludeBlocks: Regroup
IncludeCategories:
    - Regex: '^<readline/'
      Priority: 1
      SortPriority: 2
    - Regex: '^<'
      Priority: 1
      SortPriority: 1
    - Regex: '^"'
      Priority: 3
InsertNewlineAtEOF: true
